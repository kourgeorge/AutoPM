# single question about live data and is worthless the day after.
tmp/

data/policy/
policy/history/

# Cached historical bars (regenerable from Alpaca), the AI decision cache (keyed by input
# hash, regenerable by re-running the backtest), and generated backtest reports — none of
# these is source, all are large and worthless to diff.
data/historicalBars/
data/aiDecisionCache.json
backtest-results/

# Old Interactive Brokers run (Sept 2026): live trading records, never committed.
ibkr-data/

# Local agent/tool scratch, never shared. `.claude/settings local.json` was tracked and
# carried a live ANTHROPIC_AUTH_TOKEN and an internal base URL into a PUBLIC repo (added
# in a446713); `.bob/` holds a generated architecture HTML that is a build artifact of a
# conversation, not a source file. Ignoring the directories, not just those two paths, so
# the next local settings file or artifact does not repeat it. If a SHARED .claude config
# is ever wanted, un-ignore it explicitly (`!.claude/settings.json`) — never the *.local.*
# variants, which is where credentials land.
.claude/
.bob/

# Conversation artifacts in the repo root, ignored for the same reason .bob/ is: generated
# by a session, not source. The architecture JSON/HTML and its visual-check renders are
# ~1.9MB of output regenerable from the code they describe.
autotrade-architecture.json
autotrade-system-architecture.html
autotrade-system-architecture.visual-check.*

# A real position export — actual holdings and cost basis. This repo is PUBLIC.
autotrade-positions-import.csv

# Account data (JSON files under data/db/), the legacy SQLite file it was exported from,
# and account job artifacts.
data/db/
data/*.sqlite*
data/jobs/
data/backups/

# Separate broker account directories contain local trading records and caches.
/data-alpaca/
/data-ibkr/

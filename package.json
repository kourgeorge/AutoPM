{
  "name": "autotrade",
  "version": "1.0.0",
  "description": "Account-scoped automated trading worker and dashboard",
  "main": "dist/daemon.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/daemon.js",
    "dev": "ts-node src/daemon.ts",
    "replay": "ts-node src/scripts/replay.ts",
    "journal": "ts-node src/scripts/journal.ts",
    "verify:policy": "ts-node src/scripts/verifyPolicyPrompt.ts",
    "backtest": "ts-node src/scripts/backtest.ts",
    "backtest:sweep": "ts-node src/scripts/backtestSweep.ts",
    "backtest:signals": "ts-node src/scripts/backtestSignalFamilies.ts",
    "backtest:ai": "ts-node src/scripts/backtestAi.ts",
    "dev:headless": "ts-node src/daemon.ts",
    "start:headless": "node dist/daemon.js",
    "test": "node --test tests/*.test.cjs",
    "import:fills": "ts-node src/scripts/importFills.ts",
    "verify:isolated": "node scripts/verify-isolated.cjs",
    "test:browser": "node --test tests/browser.check.cjs tests/web-client.check.cjs",
    "start:engine": "node dist/daemon.js",
    "start:tui": "node dist/tui.js",
    "start:web": "node dist/web.js",
    "dev:engine": "ts-node src/daemon.ts",
    "dev:tui": "ts-node src/tui.ts",
    "dev:web": "ts-node src/web.ts",
    "start:engine+tui": "node dist/launch.js tui",
    "start:engine+web": "node dist/launch.js web",
    "dev:engine+tui": "node -r ts-node/register src/launch.ts tui",
    "dev:engine+web": "node -r ts-node/register src/launch.ts web"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@stoqey/ib": "^1.6.6",
    "@types/blessed": "^0.1.27",
    "asciichart": "^1.5.25",
    "axios": "^1.7.0",
    "blessed": "^0.1.81",
    "dotenv": "^16.4.0",
    "js-yaml": "^5.2.3",
    "rxjs": "^7.8.2",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/asciichart": "^1.5.8",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

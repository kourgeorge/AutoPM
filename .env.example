# ── Broker selection ─────────────────────────────────────────────────────────
# BROKER=alpaca   (default — paper or live Alpaca)
# BROKER=ibkr     (Interactive Brokers via TWS or IB Gateway)

# ── IBKR connection (only needed when BROKER=ibkr) ───────────────────────────
# TWS paper port: 7497  |  TWS live port: 7496
# IB Gateway paper: 4002  |  IB Gateway live: 4001
# IBKR_HOST=localhost
# IBKR_PORT=7497
# IBKR_CLIENT_ID=1
# IBKR_ACCOUNT=           # leave blank for single-account setups

# ── Alpaca API credentials ────────────────────────────────────────────────────
# Get from: https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_KEY_ID=your_paper_key_id_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Alpaca base URLs (defaults shown — switch to live by changing ALPACA_BASE_URL)
# Paper trading:  https://paper-api.alpaca.markets
# Live trading:   https://api.alpaca.markets
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_DATA_URL=https://data.alpaca.markets

# ── AI engine: seamless provider switching ────────────────────────────────────
# The agent can work with ANY OpenAI-compatible API or use Anthropic directly.
# Just set AI_PROVIDER, AI_MODEL, and AI_API_KEY — the system handles the rest.

# Your API key (format depends on provider):
#   Anthropic:  sk-ant-... or claude-api-key
#   OpenAI:     sk-proj-... or sk-...
#   Groq:       gsk_... 
#   Ollama:     any value (local, no key needed)
#   Azure:      your-azure-api-key
#   LiteLLM:    depends on your proxy config
AI_API_KEY=your_api_key_here

# AI Provider (default: anthropic)
# Supported: anthropic, openai, groq, ollama, cohere, together, or any LiteLLM-compatible endpoint
# AI_PROVIDER=anthropic

# Model name — depends on provider:
#   Anthropic:  claude-sonnet-4-6 (default), claude-opus-4-6, claude-haiku-4-5-20251001
#   OpenAI:     gpt-4o, gpt-4o-mini, gpt-4-turbo
#   Groq:       mixtral-8x7b-32768, llama-3.3-70b-versatile
#   Ollama:     llama2, mistral, neural-chat, etc.
#   Cohere:     command-r-plus, command-r
#   Together:   meta-llama/Llama-3-70b-chat-hf
# AI_MODEL=claude-sonnet-4-6

# Custom base URL. Optional for the providers above; REQUIRED for any provider name not in
# that list — an unrecognised name without a base URL is an error, not a guessed domain.
# Useful for:
#   - LiteLLM proxy:     http://localhost:8000/v1
#   - Azure OpenAI:      https://{resource}.openai.azure.com/v1
#   - Local Ollama:      http://localhost:11434/v1
#   - Self-hosted LM Studio: http://localhost:1234/v1
#   - Custom OpenAI clone: https://your-api.example.com/v1
# AI_BASE_URL=

# Optional token limits
# AI_MAX_TOKENS=4096
# AI_MAX_TOOL_ROUNDS=10

# ──────────────────────────────────────────────────────────────────────────────
# Quick setup examples:
# ──────────────────────────────────────────────────────────────────────────────
#
# 1. DEFAULT - Anthropic (Claude Sonnet 4.6):
#    AI_PROVIDER=anthropic
#    AI_MODEL=claude-sonnet-4-6
#    AI_API_KEY=sk-ant-...
#
# 2. OpenAI (GPT-4o):
#    AI_PROVIDER=openai
#    AI_MODEL=gpt-4o
#    AI_API_KEY=sk-proj-...
#
# 3. Groq (fast, free tier available):
#    AI_PROVIDER=groq
#    AI_MODEL=mixtral-8x7b-32768
#    AI_API_KEY=gsk_...
#
# 4. Local Ollama (completely private):
#    AI_PROVIDER=ollama
#    AI_MODEL=llama2
#    AI_BASE_URL=http://localhost:11434/v1
#    AI_API_KEY=not-needed
#
# 5. Azure OpenAI:
#    AI_PROVIDER=openai
#    AI_MODEL=gpt-4o
#    AI_BASE_URL=https://{your-resource}.openai.azure.com/v1
#    AI_API_KEY=your-azure-key
#
# 6. LiteLLM Proxy (multi-provider):
#    AI_PROVIDER=openai  # Any name, LiteLLM proxy routes it
#    AI_MODEL=gpt-4o     # Or any other model name
#    AI_BASE_URL=http://localhost:8000/v1
#    AI_API_KEY=your-proxy-key

# ── Risk / strategy overrides ────────────────────────────────────────────────
# MAX_POSITIONS=5
# POSITION_SIZE_PCT=0.05
